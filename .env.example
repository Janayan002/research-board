# Copy this file to .env.local and fill in your key.
# Each person can also connect their OWN keys in the app ("Connect AI"); theirs are used first.
# The keys here are a fallback for everyone. On a shared deployment, leave them EMPTY so
# people use their own keys and you don't pay for their usage.
# Get a key at https://platform.claude.com (Settings → API keys).
# With no key anywhere: mock results in development, a "Connect AI" prompt in production.
ANTHROPIC_API_KEY=

# Optional but recommended: Brave Search API key for fast, Google-like web + image search.
# This is a DIFFERENT key from your Claude key. Get one at https://api-dashboard.search.brave.com
# (subscribe to the Search plan first — it has free monthly credit — then API keys → Add API key).
# Without it, Web/Images search falls back to Claude web search (slower).
BRAVE_API_KEY=

# Optional: which models the fallback keys above use (cheap model by default).
# People using their own key pick the model themselves.
RESEARCH_MODEL=claude-haiku-5-5
CARD_MODEL=claude-haiku-5-5

# Optional: cap on web searches per request (each search costs $0.01)
MAX_SEARCHES_PER_REQUEST=4

# Optional: a password for the whole site (set this when it's deployed publicly,
# so only people you share it with can use your API keys). Leave empty to keep it open.
SITE_PASSWORD=
